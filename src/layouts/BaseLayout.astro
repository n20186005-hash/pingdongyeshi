---
import '../styles/global.css';
import { ATTRACTION, SITE_NAME, SITE_NAME_EN, SITE_URL, type Locale } from '../data/site';
import { absoluteUrl, htmlLang, ogLocale } from '../i18n';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  locale: Locale;
  path?: string;
  title: string;
  description: string;
  jsonLd: unknown | unknown[];
  ogImage?: string;
  noindex?: boolean;
  alternates?: Locale[];
  isHome?: boolean;
}

const { locale, path = '', title, description, jsonLd, ogImage, noindex = false, alternates = [], isHome = false } =
  Astro.props;

const canonical = absoluteUrl(locale, path);
const ogImageUrl = `${SITE_URL}${ogImage ?? ATTRACTION.ogImage}`;
const structured = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const robotsContent = noindex
  ? 'noindex,nofollow'
  : 'index,follow,max-image-preview:large,max-snippet:-1';
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0810" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonical} />

    {alternates.length > 0 && (
      <>
        {alternates.map((alt) => (
          <link rel="alternate" hreflang={alt === 'zh' ? 'zh-Hant-TW' : alt} href={absoluteUrl(alt, path)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={absoluteUrl('zh', path)} />
      </>
    )}

    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:site_name" content={locale === 'en' ? SITE_NAME_EN : SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={locale === 'en' ? 'Original conceptual market illustration, not a photograph' : '原創概念示意圖，非屏東夜市實景攝影'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />

    {structured.map((item) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(item)}></script>
    ))}

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <SiteHeader locale={locale} isHome={isHome} />
    <main id="top">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => { if (location.protocol === 'https:') navigator.serviceWorker.register('/sw.js').catch(() => {}); });
      }
    </script>
  </body>
</html>
