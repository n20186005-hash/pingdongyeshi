---
import { ATTRACTION, type Locale } from '../data/site';
import { guideLinks, localizedPath, ui } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = ui[locale];
const guides = guideLinks(locale);
const homeHref = localizedPath(locale);
---

<footer class="border-t border-white/10 py-10">
  <div class="container grid gap-8 md:grid-cols-[1.3fr_.7fr]">
    <div>
      <img src="/logo.svg" alt={copy.brandAlt} class="h-11 w-auto opacity-90" />
      <p class="mt-3 max-w-2xl text-sm text-[#8f8171]">{copy.disclaimer}</p>
      <p class="mt-4 text-sm text-[#8f8171]">
        {locale === 'en'
          ? `${ATTRACTION.streetAddress.en}, ${ATTRACTION.addressLocality.en}, ${ATTRACTION.addressRegion.en} ${ATTRACTION.postalCode}, Taiwan · Plus Code ${ATTRACTION.plusCode.split(' ')[0]}`
          : `${ATTRACTION.addressRegion.zh}${ATTRACTION.addressLocality.zh}${ATTRACTION.streetAddress.zh}（${ATTRACTION.postalCode}）・Plus Code ${ATTRACTION.plusCode.split(' ')[0]}`}
      </p>
      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm">
        <a class="text-[#ffb20f] underline underline-offset-4" href={ATTRACTION.mapsShare} rel="noopener noreferrer" target="_blank">{locale === 'en' ? 'Open in Google Maps ↗' : '在 Google 地圖開啟 ↗'}</a>
        <a class="text-[#a1978a] underline underline-offset-4" href={ATTRACTION.officialSource} rel="noopener noreferrer" target="_blank">{locale === 'en' ? 'Pingtung County tourism page ↗' : '屏東縣政府觀光頁面 ↗'}</a>
      </div>
    </div>
    <div>
      <p class="kicker">{copy.footerLinksTitle}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="text-[#a1978a] underline underline-offset-4 hover:text-[#ffb20f]" href={homeHref}>{copy.home}</a></li>
        {guides.map((guide) => (
          <li><a class="text-[#a1978a] underline underline-offset-4 hover:text-[#ffb20f]" href={guide.href}>{guide.title}</a></li>
        ))}
      </ul>
      <p class="mt-6 text-xs text-[#6f655b]">{copy.tagline}</p>
    </div>
  </div>
</footer>
