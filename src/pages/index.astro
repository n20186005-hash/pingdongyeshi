---
import '../styles/global.css';

const title = '屏東觀光夜市｜民族路老字號小吃與在地夜食指南';
const description = '屏東觀光夜市（民族路夜市）單頁旅遊指南：老字號小吃、營業資訊、交通、停車、周邊景點、最佳造訪時段、FAQ 與 Google 地圖。';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;

const photos = [
  {
    src: 'https://www.pingtungtour.com.tw/images/media/spots/p_20211216171430_0027_370.png',
    alt: '屏東觀光夜市民族路晚間街景，兩側小吃攤與招牌亮起',
    caption: '民族路入夜後，招牌、蒸氣與人聲一起把街道點亮。'
  },
  {
    src: 'https://www.pingtungtour.com.tw/images/media/spots/p_20211216171511_0027_201.png',
    alt: '屏東觀光夜市巷內老字號汕頭火鍋與夜市店家',
    caption: '夜市不只是攤販，也藏著許多經營多年的固定店面。'
  },
  {
    src: 'https://www.pingtungtour.com.tw/images/media/spots/p_20211216171535_0027_957.jpg',
    alt: '屏東觀光夜市店家備料的真實工作場景',
    caption: '屏東夜市的魅力，來自每天重複備料、開火、端菜的日常。'
  }
];

const foods = [
  {
    name: '民族夜市𩵚魠魚焿',
    tag: '復興路口',
    text: '炸得酥香的魚塊浸入帶南部甜味的羹湯，是夜市入口附近辨識度很高的一碗。',
    hint: '想一次多吃幾家，建議先點小份或與同行者分食。'
  },
  {
    name: '正老牌屏東肉圓',
    tag: '蒸式肉圓',
    text: '屏東代表性的蒸肉圓，外皮軟Q、口感與彰化常見炸肉圓很不一樣。',
    hint: '部分肉圓店偏早營業，若專程為肉圓而來可安排上午到中午。'
  },
  {
    name: '新園汕頭火鍋',
    tag: '老派鍋氣',
    text: '汕頭火鍋是官方旅遊介紹中特別點名的在地味道，適合多人一起坐下來慢慢吃。',
    hint: '晚餐時段熱門，候位與店休以現場或店家公告為準。'
  },
  {
    name: '王朝香菇肉羹旗魚羹',
    tag: '台味羹湯',
    text: '香菇肉羹、旗魚羹這類帶勾芡與柴魚香氣的傳統羹湯，是屏東街頭很踏實的日常味。',
    hint: '夜市攤商各自營業，整體開放時間不代表每一家都同步開店。'
  }
];

const sights = [
  { name: '阿猴慈鳳宮', type: '信仰', text: '從車站與夜市商圈就能順路走訪的老廟，適合把小吃行程接上一段老城散步。' },
  { name: '屏東公園', type: '綠地', text: '百年城市公園，保有朝陽門、歷史記憶與大片樹蔭，吃飽後散步很剛好。' },
  { name: '勝利星村創意生活園區', type: '眷村', text: '日式宿舍群活化成餐飲、選物與文化街區，從白天拍到傍晚都很有層次。' },
  { name: '職人町', type: '創意聚落', text: '舊空間轉型的城市創意聚落，可和勝利星村安排在同一趟市區慢遊。' }
];

const faqs = [
  {
    q: '屏東觀光夜市要門票嗎？',
    a: '不用。夜市屬開放街區，免費進入；餐飲、購物依各攤店實際消費。'
  },
  {
    q: '官方營業時間是幾點？',
    a: '屏東縣政府旅遊頁目前列出 10:30–00:00。不過夜市由許多獨立攤店組成，各家實際開店與休息時間不同；Google 地圖也可能以全天可到訪呈現，因此若有指定必吃店，建議另外確認店家當日資訊。'
  },
  {
    q: '從屏東火車站怎麼走？',
    a: '搭台鐵到屏東站後，往民族路、復興路方向步行即可到達核心區，通常約 10 分鐘上下；不想走也可搭計程車或使用市區共享單車。'
  },
  {
    q: '開車好停嗎？',
    a: '夜市周邊有多處收費停車場，例如靠近民族路、復興路一帶的私人停車場。晚餐與假日尖峰可能較滿，建議提早到或直接改搭火車。收費、空位與營業時間以現場公告為準。'
  },
  {
    q: '最推薦什麼時間去？',
    a: '想感受最完整的夜市氣氛，可把主要逛吃時段放在傍晚到晚間；若目標是早開的肉圓、傳統小吃，白天也值得來。怕人多則避開週末晚餐尖峰。'
  },
  {
    q: '建議停留多久？',
    a: '只挑兩三樣小吃約 60–90 分鐘；若想坐下吃火鍋、再散步逛巷弄，預留 2–3 小時會比較從容。'
  }
];

const localBusinessJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: '屏東觀光夜市',
  alternateName: ['屏東夜市', '民族路夜市', 'Pingtung Night Market'],
  description: '位於屏東市民族路、靠近屏東車站的老字號美食聚集地，以蒸式肉圓、雞肉飯、羹湯、汕頭火鍋、冰品與傳統小吃聞名。',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '民族路36號',
    addressLocality: '屏東市',
    addressRegion: '屏東縣',
    postalCode: '900',
    addressCountry: 'TW'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 22.6698878,
    longitude: 120.4898724
  },
  openingHours: 'Mo-Su 10:30-00:00',
  isAccessibleForFree: true,
  priceRange: '免費入場；餐飲依店家計價',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 4.2,
    reviewCount: 22305,
    bestRating: 5,
    worstRating: 1
  },
  ...(canonical ? { url: canonical } : {})
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---
<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0b0810" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="shortcut icon" href="/favicon.ico" />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>

    <header class="fixed inset-x-0 top-0 z-40 border-b border-white/10 bg-[#09070d]/82 backdrop-blur-xl">
      <div class="container flex h-[72px] items-center justify-between gap-5">
        <a href="#top" class="flex items-center gap-3" aria-label="回到頁首">
          <img src="/logo.svg" alt="屏東觀光夜市" class="h-10 w-auto" />
        </a>
        <nav class="hidden items-center gap-6 text-sm md:flex" aria-label="主要導覽">
          <a class="nav-link" href="#eat">吃什麼</a>
          <a class="nav-link" href="#plan">怎麼逛</a>
          <a class="nav-link" href="#transport">交通停車</a>
          <a class="nav-link" href="#nearby">周邊</a>
          <a class="nav-link" href="#faq">FAQ</a>
        </nav>
        <a href="#map" class="rounded-full bg-[#ffb20f] px-4 py-2 text-sm font-black text-[#1a0c08] transition hover:translate-y-[-1px]">看地圖</a>
      </div>
    </header>

    <main id="top">
      <section class="relative min-h-[760px] overflow-hidden pt-[72px]">
        <div class="absolute inset-0">
          <img class="hero-photo h-full w-full object-cover" src={photos[0].src} alt={photos[0].alt} loading="eager" fetchpriority="high" referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(5,3,9,.94)_0%,rgba(7,5,11,.72)_46%,rgba(8,5,10,.28)_78%,rgba(8,5,10,.5)_100%)]"></div>
          <div class="absolute inset-x-0 bottom-0 h-48 bg-gradient-to-t from-[#0a0710] to-transparent"></div>
        </div>
        <div class="container relative grid min-h-[688px] items-center py-16 lg:grid-cols-[1.15fr_.85fr]">
          <div class="max-w-3xl">
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="badge">屏東市・民族路</span>
              <span class="badge">Google 4.2 / 5</span>
            </div>
            <p class="kicker mb-4">Pingtung Night Market · 在地人的大廚房</p>
            <h1 class="display glow text-5xl font-black text-[#fff3cf] sm:text-7xl lg:text-[6.7rem]">不是只在晚上<br /><span class="text-[#ffb20f]">才好吃的夜市</span></h1>
            <p class="mt-7 max-w-2xl text-lg text-[#e4d8c7] md:text-xl">屏東觀光夜市沿著民族路展開。蒸式肉圓、雞肉飯、羹湯、汕頭火鍋與冰品，把一條街變成從白天一路吃到深夜的在地食堂。</p>
            <div class="mt-8 flex flex-wrap gap-3">
              <a href="#eat" class="rounded-full bg-[#f12d3c] px-6 py-3 font-black text-white shadow-[0_0_30px_rgba(241,45,60,.28)] transition hover:scale-[1.02]">先決定吃什麼</a>
              <a href="#plan" class="rounded-full border border-white/20 bg-white/5 px-6 py-3 font-bold text-[#fff3cf] backdrop-blur transition hover:bg-white/10">快速看行程</a>
            </div>
            <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-3 text-sm text-[#c5b7a5]">
              <span>📍 屏東縣屏東市民族路36號</span>
              <span>🚉 屏東站步行約 10 分鐘</span>
              <span>🎫 免費進入</span>
            </div>
          </div>
          <div class="mt-10 flex justify-center lg:mt-0 lg:justify-end">
            <div class="ticket w-full max-w-[350px] p-7 shadow-2xl">
              <div class="flex items-start justify-between gap-4 border-b border-dashed border-black/25 pb-5">
                <div><p class="text-xs font-black tracking-[.18em] text-[#8a3e21]">TONIGHT'S TICKET</p><h2 class="mt-1 text-2xl font-black">屏東夜食通行證</h2></div>
                <div class="rounded-full border-2 border-[#a34726] px-2 py-1 text-xs font-black text-[#a34726]">FREE</div>
              </div>
              <dl class="mt-5 space-y-4 text-sm">
                <div class="flex justify-between gap-4"><dt class="font-bold text-black/55">官方旅遊頁營業</dt><dd class="font-black">10:30–00:00</dd></div>
                <div class="flex justify-between gap-4"><dt class="font-bold text-black/55">最有夜市感</dt><dd class="font-black">傍晚～晚間</dd></div>
                <div class="flex justify-between gap-4"><dt class="font-bold text-black/55">建議停留</dt><dd class="font-black">1.5–3 小時</dd></div>
                <div class="flex justify-between gap-4"><dt class="font-bold text-black/55">支付準備</dt><dd class="font-black">現金最穩妥</dd></div>
              </dl>
              <p class="mt-6 rounded-xl bg-black/6 p-3 text-xs leading-relaxed text-black/65">夜市是許多獨立攤店組成，各家實際營業時段不同；指定必吃店請以店家當日公告為準。</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section pt-14">
        <div class="container grid gap-7 md:grid-cols-3">
          <article class="sign-card p-6"><p class="kicker">01 · 吃法</p><h2 class="mt-2 text-2xl font-black text-[#fff3cf]">先小吃，再坐下</h2><p class="mt-3 text-[#cfc0ae]">先用肉圓、羹湯或雞肉飯開場，再看胃口決定是否安排汕頭火鍋，最不容易第一攤就飽。</p></article>
          <article class="sign-card p-6"><p class="kicker">02 · 節奏</p><h2 class="mt-2 text-2xl font-black text-[#fff3cf]">白天與晚上不同</h2><p class="mt-3 text-[#cfc0ae]">屏東夜市不是純晚間攤集。部分傳統早餐、午間小吃早開，夜間則換成另一批店家與用餐氛圍。</p></article>
          <article class="sign-card p-6"><p class="kicker">03 · 巷弄</p><h2 class="mt-2 text-2xl font-black text-[#fff3cf]">別只走民族路</h2><p class="mt-3 text-[#cfc0ae]">官方旅遊頁特別提醒可轉進平行的露市巷，看看老店舖與街區尺度，感受屏東老城的另一面。</p></article>
        </div>
      </section>

      <section id="eat" class="section">
        <div class="container">
          <div class="mb-10 grid gap-6 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
            <div><p class="kicker">What to eat</p><h2 class="display mt-2 text-5xl font-black text-[#fff3cf] md:text-6xl">先吃屏東味，<br />再追流行。</h2></div>
            <p class="max-w-2xl text-lg text-[#cfc0ae]">官方屏東旅遊介紹把愛玉冰、香菇肉羹、汕頭火鍋與「蒸」式肉圓列為代表；再搭配夜市常見的雞肉飯、𩵚魠魚焿、米血、冰品，就能吃出這條街的個性。</p>
          </div>
          <div class="grid gap-5 md:grid-cols-2">
            {foods.map((food, i) => (
              <article class="sign-card group p-6 transition hover:-translate-y-1 hover:border-white/20">
                <div class="flex items-center justify-between gap-4"><span class="text-4xl font-black text-white/10">0{i + 1}</span><span class="sticker text-xs">{food.tag}</span></div>
                <h3 class="mt-4 text-2xl font-black text-[#fff3cf]">{food.name}</h3>
                <p class="mt-3 text-[#d5c7b5]">{food.text}</p>
                <p class="mt-4 border-l-2 border-[#ff6a21] pl-3 text-sm text-[#a99b8b]">{food.hint}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section bg-white/[.025]">
        <div class="container">
          <div class="flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="kicker">Street snapshots</p><h2 class="display mt-2 text-4xl font-black md:text-5xl">真正的夜市，是正在營業的樣子。</h2></div><p class="max-w-xl text-sm text-[#a99b8b]">下列為屏東縣政府「屏東旅行」景點頁之實景影像；本站不使用 AI 生成景點照片。</p></div>
          <div class="mt-10 grid gap-5 lg:grid-cols-12">
            <figure class="photo-frame market-border lg:col-span-7"><img src={photos[0].src} alt={photos[0].alt} class="aspect-[16/10] h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer" /><figcaption class="absolute bottom-0 z-10 p-5 text-sm text-white/85">{photos[0].caption}</figcaption></figure>
            <div class="grid gap-5 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
              {photos.slice(1).map((photo) => <figure class="photo-frame market-border"><img src={photo.src} alt={photo.alt} class="aspect-[16/9] h-full w-full object-cover" loading="lazy" referrerpolicy="no-referrer" /><figcaption class="absolute bottom-0 z-10 p-4 text-sm text-white/85">{photo.caption}</figcaption></figure>)}
            </div>
          </div>
        </div>
      </section>

      <section id="plan" class="section">
        <div class="container grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
          <div>
            <p class="kicker">Visit plan</p><h2 class="display mt-2 text-5xl font-black">怎麼逛最順</h2>
            <div class="mt-8 timeline ml-2 space-y-8">
              <div class="timeline-item"><h3 class="font-black text-[#fff3cf]">① 屏東站下車，先別急著搭車</h3><p class="mt-1 text-[#c7b8a6]">夜市離車站近，步行本身就是進入市中心節奏的最好方式。</p></div>
              <div class="timeline-item"><h3 class="font-black text-[#fff3cf]">② 先掃一遍，再回頭點餐</h3><p class="mt-1 text-[#c7b8a6]">民族路店家密集，第一眼喜歡的不一定是唯一選擇；先看一圈能避免太快吃飽。</p></div>
              <div class="timeline-item"><h3 class="font-black text-[#fff3cf]">③ 吃完拐進露市巷</h3><p class="mt-1 text-[#c7b8a6]">從主街轉入平行巷弄，看看老建築與店舖尺度，夜市會從「吃」變成城市散步。</p></div>
              <div class="timeline-item"><h3 class="font-black text-[#fff3cf]">④ 再接屏東公園或勝利星村</h3><p class="mt-1 text-[#c7b8a6]">若還有體力，把餐後散步延長到市區歷史與創意街區，行程會更完整。</p></div>
            </div>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <div class="ticket p-6"><p class="text-xs font-black tracking-[.16em] text-[#a64d28]">COST</p><h3 class="mt-2 text-2xl font-black">門票 / 費用</h3><p class="mt-3 text-black/70">夜市免費進入，只有餐飲與購物消費。不同攤店價格以現場標示為準，不在網站硬寫易過期菜單價。</p></div>
            <div class="sign-card p-6"><p class="kicker">TIME</p><h3 class="mt-2 text-2xl font-black text-[#fff3cf]">最佳時段</h3><p class="mt-3 text-[#c7b8a6]">想看燈火與較完整的晚餐選擇，傍晚後最有氣氛；想吃早開肉圓與傳統早餐型小吃，白天更對味。</p></div>
            <div class="sign-card p-6"><p class="kicker">STAY</p><h3 class="mt-2 text-2xl font-black text-[#fff3cf]">停留多久</h3><p class="mt-3 text-[#c7b8a6]">快吃 1–1.5 小時；想坐下吃鍋、拍照、逛巷弄，抓 2–3 小時比較舒服。</p></div>
            <div class="sign-card p-6"><p class="kicker">MONEY</p><h3 class="mt-2 text-2xl font-black text-[#fff3cf]">帶什麼</h3><p class="mt-3 text-[#c7b8a6]">小額現金、可重複使用提袋、紙巾。部分店家可電子支付，但夜市仍以現金最通用。</p></div>
          </div>
        </div>
      </section>

      <section id="transport" class="section bg-[#f4ead2] text-[#22130f]">
        <div class="container">
          <div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr]">
            <div><p class="text-xs font-black uppercase tracking-[.2em] text-[#a84727]">Getting there</p><h2 class="display mt-2 text-5xl font-black">交通很市中心，<br />不用把它想太難。</h2></div>
            <div class="grid gap-4 sm:grid-cols-2">
              <article class="rounded-2xl border border-black/10 bg-white/45 p-5"><p class="font-black">🚆 台鐵</p><p class="mt-2 text-sm text-black/65">屏東站下車後沿民族路、復興路方向步行，約 10 分鐘上下抵達夜市核心區。</p></article>
              <article class="rounded-2xl border border-black/10 bg-white/45 p-5"><p class="font-black">🚌 公車</p><p class="mt-2 text-sm text-black/65">市區公車可在車站或鄰近站點轉乘；路線可能調整，建議當天用即時公車系統確認最接近「屏東電信局／中央市場」一帶的停靠。</p></article>
              <article class="rounded-2xl border border-black/10 bg-white/45 p-5"><p class="font-black">🚗 自駕</p><p class="mt-2 text-sm text-black/65">從台 1 線進屏東市區後接復興路、民族路周邊。夜市本身路幅較窄，不建議在核心路段找路邊位。</p></article>
              <article class="rounded-2xl border border-black/10 bg-white/45 p-5"><p class="font-black">🛵 機車 / 單車</p><p class="mt-2 text-sm text-black/65">適合市區短距離移動，但夜市巷弄人車混行時務必減速，停放也以合法停車格為原則。</p></article>
            </div>
          </div>
          <div class="mt-9 rounded-3xl border border-black/10 bg-[#22130f] p-6 text-[#f8edda] md:p-8">
            <div class="grid gap-5 md:grid-cols-[.3fr_1fr]"><div><p class="kicker">Parking</p><h3 class="mt-2 text-2xl font-black">停車資訊</h3></div><div><p class="text-[#d9c9b2]">夜市周邊有多處收費停車場，公開資料可見「永發停車屏東夜市站」與「屏東夜市收費停車場」等選擇。晚餐與週末尖峰建議先停好再步行，不要把時間耗在夜市核心巷弄繞車位。</p><p class="mt-3 text-sm text-[#aa9a86]">停車場名稱、收費、空位與營業狀態會變動，請以現場或即時地圖資訊為準。</p></div></div>
          </div>
        </div>
      </section>

      <section id="nearby" class="section">
        <div class="container">
          <div class="grid gap-12 lg:grid-cols-2">
            <div>
              <p class="kicker">Nearby sights</p><h2 class="display mt-2 text-4xl font-black md:text-5xl">吃飽後，繼續逛屏東市。</h2>
              <div class="mt-8 space-y-4">
                {sights.map((sight) => <article class="sign-card flex gap-4 p-5"><div class="mt-1 h-10 w-10 shrink-0 rounded-full border border-[#ffb20f]/35 bg-[#ffb20f]/10 text-center text-sm font-black leading-10 text-[#ffb20f]">{sight.type.slice(0,1)}</div><div><div class="flex flex-wrap items-center gap-2"><h3 class="font-black text-[#fff3cf]">{sight.name}</h3><span class="rounded-full bg-white/5 px-2 py-0.5 text-[11px] text-[#9f9181]">{sight.type}</span></div><p class="mt-1 text-sm text-[#b9aa99]">{sight.text}</p></div></article>)}
              </div>
            </div>
            <div>
              <p class="kicker">One more bite</p><h2 class="display mt-2 text-4xl font-black md:text-5xl">周邊美食，不只夜市裡。</h2>
              <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <article class="sign-card p-5"><h3 class="font-black text-[#fff3cf]">雞肉飯與米血</h3><p class="mt-2 text-sm text-[#b9aa99]">民族路、民權路一帶有多家老店；鹹香雞汁配米血，是很典型的屏東快速一餐。</p></article>
                <article class="sign-card p-5"><h3 class="font-black text-[#fff3cf]">青草茶 / 愛玉 / 冰品</h3><p class="mt-2 text-sm text-[#b9aa99]">南台灣晚間仍常溫熱，吃完羹湯或火鍋後，用茶飲、愛玉或泡泡冰收尾很合理。</p></article>
                <article class="sign-card p-5"><h3 class="font-black text-[#fff3cf]">切仔擔與黑白切</h3><p class="mt-2 text-sm text-[#b9aa99]">從米腸、粉腸到湯品，這類傳統攤位適合多人點幾盤共享，也最有地方日常感。</p></article>
                <article class="sign-card p-5"><h3 class="font-black text-[#fff3cf]">汕頭火鍋</h3><p class="mt-2 text-sm text-[#b9aa99]">如果想把夜市吃成正式晚餐，屏東市區的汕頭火鍋非常有代表性，適合留到行程後半段。</p></article>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="map" class="section pt-8">
        <div class="container">
          <div class="mb-7 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="kicker">Map</p><h2 class="display mt-2 text-4xl font-black md:text-5xl">先找到民族路，再開始聞香走。</h2></div><a class="text-sm font-bold text-[#ffb20f] underline decoration-white/20 underline-offset-4" href="https://maps.app.goo.gl/hiM2jusJtw8vg6D87" rel="noopener noreferrer" target="_blank">在 Google 地圖開啟 ↗</a></div>
          <div class="map-wrap market-border overflow-hidden rounded-3xl bg-[#14101a]">
            <iframe title="屏東觀光夜市 Google 地圖" src="https://www.google.com/maps?q=%E5%B1%8F%E6%9D%B1%E8%A7%80%E5%85%89%E5%A4%9C%E5%B8%82&output=embed&hl=zh-TW&gl=tw" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          </div>
        </div>
      </section>

      <section id="faq" class="section">
        <div class="container grid gap-10 lg:grid-cols-[.7fr_1.3fr]">
          <div><p class="kicker">FAQ</p><h2 class="display mt-2 text-5xl font-black">第一次來，<br />先看這幾題。</h2><p class="mt-5 max-w-md text-[#aa9b8a]">營業與評分會變動；本頁優先採屏東縣政府旅遊資訊，並用 Google 地圖公開資料補充評分與位置。</p></div>
          <div class="faq">
            {faqs.map((item, i) => <details open={i === 0}><summary>{item.q}</summary><p class="mt-3 max-w-3xl text-[#bdae9c]">{item.a}</p></details>)}
          </div>
        </div>
      </section>

      <section class="pb-10">
        <div class="container rounded-3xl border border-white/10 bg-white/[.03] p-6 text-sm text-[#998b7b] md:p-8">
          <p class="font-black text-[#d6c6b4]">資料來源與實用提醒</p>
          <p class="mt-2">景點名稱、地址、特色與官方時段主要參考屏東縣政府「屏東旅行」；交通補充參考台灣旅遊景點資料與 Google 地圖公開資訊。評分與評論數會隨時間變動，請以 Google 地圖最新顯示為準。</p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
            <a class="underline underline-offset-4" href="https://www.pingtungtour.com.tw/spots_info/?27.html" target="_blank" rel="noopener noreferrer">屏東旅行・屏東觀光夜市 ↗</a>
            <a class="underline underline-offset-4" href="https://www.google.com/maps/place/%E5%B1%8F%E4%B8%9C%E8%A7%82%E5%85%89%E5%A4%9C%E5%B8%82/data=!4m7!3m6!1s0x346e1784503cbaed:0x8549a3a6db254816!8m2!3d22.6698878!4d120.4898724!16s%2Fg%2F11b_2qfnfj" target="_blank" rel="noopener noreferrer">Google 地圖 ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t border-white/10 py-10">
      <div class="container flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div><img src="/logo.svg" alt="屏東觀光夜市" class="h-11 w-auto opacity-90" /><p class="mt-3 max-w-2xl text-sm text-[#8f8171]">非官方旅遊資訊網站，與屏東縣政府、Google 或夜市各攤商無隸屬或代表關係；營業、價格、交通與活動資訊請以現場及官方公告為準。</p></div>
        <p class="text-xs text-[#6f655b]">Made for a hungry walk through Pingtung.</p>
      </div>
    </footer>
  </body>
</html>
