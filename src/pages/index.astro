---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { zhContent } from '../content/home.zh';
import { attractionSchema, faqSchema, organizationSchema, websiteSchema } from '../lib/schema';

const jsonLd = [
  organizationSchema(),
  websiteSchema('zh'),
  attractionSchema('zh'),
  faqSchema(zhContent.faq.items)
];
---

<BaseLayout
  locale="zh"
  title={zhContent.metaTitle}
  description={zhContent.metaDescription}
  jsonLd={jsonLd}
  alternates={['zh', 'en']}
  isHome
>
  <HomeContent locale="zh" content={zhContent} />
</BaseLayout>
